# Public Supabase values. These two variables may be used by browser code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase secret key. Never add NEXT_PUBLIC_ to this name.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Server-only scheduler authentication secret.
CRON_SECRET=replace_with_a_long_random_value

# Server-only Gmail SMTP settings. Use a Google App Password, never the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_APP_PASSWORD=replace_with_google_app_password
ALERT_EMAIL_FROM=TradePulse Alerts <alerts@example.com>
ALERT_EMAIL_TO=you@example.com

# Application display and callback settings.
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Shanghai

# Audited application configuration. Do not expose strategy controls in the dashboard.
STRATEGY_VERSION=baseline-001
NOTIFY_GRADE_A=true
NOTIFY_GRADE_B=true
NOTIFY_GRADE_C=false
NOTIFICATION_SAFE_MODE=true
