  "signalDefinition": {
    "primitiveInputs": [
      "topTraderAccountLongShortRatio",
      "topTraderPositionLongShortRatio",
      "globalAccountLongShortRatio"
    ],
    "ratioDomain": "Every ratio must be finite and strictly greater than zero.",
    "transforms": {
      "A": "ln(topTraderAccountLongShortRatio)",
      "P": "ln(topTraderPositionLongShortRatio)",
      "G": "ln(globalAccountLongShortRatio)"
    },
    "predicates": {
      "LONG_CROWD": {
        "condition": "P > 0 && P > A && A > G",
        "crowdedSide": "LONG",
        "advisoryDirection": "SHORT"
      },
      "SHORT_CROWD": {
        "condition": "P < 0 && P < A && A < G",
        "crowdedSide": "SHORT",
        "advisoryDirection": "LONG"
      },
      "otherwise": "NO_SIGNAL"
    },
    "zeroTunedOrdinalStructure": true,
