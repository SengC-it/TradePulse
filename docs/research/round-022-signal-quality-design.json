    "criticalIgnoreConditions": [
      "direction=NO_SIGNAL",
      "closedCandle=false",
      "freshData=false",
      "identityComplete=false",
      "strategySnapshotComplete=false",
      "directionalRiskGeometryInvalid=true"
    ],
    "gradeRules": {
      "A": "Valid LONG or SHORT, all critical facts valid, market context SUPPORTIVE, and risk state STANDARD.",
      "B": "Valid LONG or SHORT, all critical facts valid, and neither the A nor C rule applies.",
      "C": "Valid LONG or SHORT, all critical facts valid, but market context is ADVERSE or UNAVAILABLE.",
      "IGNORE": "NO_SIGNAL or any critical fact/geometry validation fails. No advisory email is produced by this layer."
    },
    "deterministicImplementation": "src/lib/research/m3-r22-signal-quality-design-protocol.ts::assessR22SignalQuality"
  },
  "longQualityAssessment": {
    "direction": "LONG",
    "riskOrdering": "stopLoss < referencePrice < takeProfit",
    "supportiveRegime": "BULL",
    "adverseRegime": "BEAR",
    "neutralRegime": "NEUTRAL",
    "invalidDirectionOrGeometry": "IGNORE"
  },
  "shortQualityAssessment": {
    "direction": "SHORT",
    "riskOrdering": "takeProfit < referencePrice < stopLoss",
    "supportiveRegime": "BEAR",
    "adverseRegime": "BULL",
    "neutralRegime": "NEUTRAL",
    "invalidDirectionOrGeometry": "IGNORE"
  },
  "marketContextAdvisory": {
    "regimes": ["BULL", "NEUTRAL", "BEAR", "UNKNOWN"],
    "alignment": ["SUPPORTIVE", "NEUTRAL", "ADVERSE", "UNAVAILABLE", "NOT_APPLICABLE"],
    "rule": "LONG aligns with BULL and SHORT aligns with BEAR; opposite regimes are ADVERSE; NEUTRAL remains NEUTRAL; UNKNOWN is UNAVAILABLE.",
    "doesNotChangeDirection": true,
    "doesNotAuthorizeExecution": true,
    "source": "EXISTING_SIGNAL_SNAPSHOT_CONTEXT_ONLY",
    "newMarketDataAcquisition": false
  },
  "riskAdvisory": {
    "purpose": "Expose pre-trade geometry and caution without sizing or execution.",
    "riskDistance": "abs(referencePrice - stopLoss)",
    "rewardDistance": "abs(takeProfit - referencePrice)",
    "riskRewardRatio": "rewardDistance / riskDistance",
    "states": {
      "STANDARD": "Valid direction-aware geometry and riskRewardRatio >= 1.",
      "CAUTION": "Valid direction-aware geometry and riskRewardRatio < 1.",
      "UNAVAILABLE": "Missing, non-positive, non-finite, or directionally invalid geometry.",
      "NOT_APPLICABLE": "NO_SIGNAL."
    },
    "noPositionSizing": true,
    "noAutomaticStopOrTarget": true,
    "noOutcomeEvaluation": true
