  "signalQualityEngine": {
    "purpose": "Classify the integrity and review priority of an already-generated formal advisory without estimating future outcome.",
    "requiredInputFacts": [
      "direction",
      "referencePrice",
      "stopLoss",
      "takeProfit",
      "closedCandle",
      "freshData",
      "identityComplete",
      "strategySnapshotComplete",
      "marketRegime"
