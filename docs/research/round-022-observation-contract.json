      "mutability": "IMMUTABLE_REQUIRED",
      "required": true,
      "status": "INSTRUMENTATION_REQUIRED"
    },
    {
      "field": "historicalReviewMetadata",
      "sourceModuleOrPersistence": "src/lib/research/historical-review-protocol.ts; public.tp_signal_advisories identity",
      "captureTime": "identity-only metadata capture not persisted as an R22 snapshot",
      "mutability": "IMMUTABLE_REQUIRED",
      "required": true,
      "status": "INSTRUMENTATION_REQUIRED"
    },
    {
      "field": "alertIntelligence",
      "sourceModuleOrPersistence": "src/lib/alert-intelligence/index.ts; src/lib/research/alert-intelligence-protocol.ts",
