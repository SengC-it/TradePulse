    },
    {
      "field": "marketContext",
      "sourceModuleOrPersistence": "src/lib/signal-quality/evaluator.ts; existing market_regime is not the full R22 snapshot",
      "captureTime": "decision-time snapshot capture not persisted",
      "mutability": "IMMUTABLE_REQUIRED",
      "required": true,
      "status": "INSTRUMENTATION_REQUIRED"
    },
    {
      "field": "riskAdvisory",
