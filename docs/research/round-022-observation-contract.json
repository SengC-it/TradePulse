      "mutability": "IMMUTABLE_REQUIRED",
      "required": true,
      "status": "INSTRUMENTATION_REQUIRED"
    },
    {
      "field": "presentation",
      "sourceModuleOrPersistence": "Email/Web presentation consumers are outside this design source set",
      "captureTime": "presentation observation source not persisted",
      "mutability": "IMMUTABLE_REQUIRED",
      "required": true,
      "status": "INSTRUMENTATION_REQUIRED"
    },
    {
      "field": "notificationDisposition",
      "sourceModuleOrPersistence": "src/lib/signal-advisory/store.ts; public.tp_signal_advisories delivery registry",
      "captureTime": "per-notification observation not persisted for all dispositions",
      "mutability": "IMMUTABLE_REQUIRED",
      "required": true,
      "status": "INSTRUMENTATION_REQUIRED"
    },
    {
      "field": "humanReviewMetadata",
      "sourceModuleOrPersistence": "No current R22 human-review observation persistence source",
      "captureTime": "review start/submission capture not persisted",
      "mutability": "IMMUTABLE_REQUIRED",
      "required": true,
      "status": "INSTRUMENTATION_REQUIRED"
    },
    {
      "field": "decisionLatencyProxyMs",
      "sourceModuleOrPersistence": "Future human-review observation instrumentation only",
      "captureTime": "review submission",
      "mutability": "IMMUTABLE_REQUIRED",
      "required": true,
      "status": "INSTRUMENTATION_REQUIRED"
    }
  ],
  "gates": [
    {"id": "O01", "status": "PASS", "rule": "Exact accepted source integrity"},
    {"id": "O02", "status": "PASS", "rule": "Stable advisory identity provenance"},
    {"id": "O03", "status": "INSTRUMENTATION_REQUIRED", "rule": "Signal, advisory, notification, and review timestamps"},
    {"id": "O04", "status": "INSTRUMENTATION_REQUIRED", "rule": "Decision-time snapshot provenance"},
    {"id": "O05", "status": "INSTRUMENTATION_REQUIRED", "rule": "Notification disposition provenance"},
    {"id": "O06", "status": "INSTRUMENTATION_REQUIRED", "rule": "Human review provenance"},
    {"id": "O07", "status": "PASS", "rule": "Economic isolation"},
    {"id": "O08", "status": "PASS", "rule": "Separate cohort denominators"},
    {"id": "O09", "status": "PASS", "rule": "Fixed prospective window"}
  ],
  "hardInvariants": [
    "zero future/economic fields",
    "zero automatic trading fields",
    "zero unstable same-input outputs",
    "zero timestamp inversion",
    "zero denominator contamination",
    "zero retrospective backfill"
  ],
  "descriptiveMetrics": [
    "signalClarity",
    "explanationCompleteness",
    "riskVisibility",
    "contextCompleteness",
    "unnecessaryAlertRate",
    "ignoreRatio",
    "duplicateAlertRate",
    "reviewCompleteness",
    "informationSufficiency",
    "decisionLatencyProxyMs"
  ],
  "forbiddenFields": [
    "PnL", "profit", "loss", "return", "forwardReturn", "futurePrice", "futureCandle",
    "takeProfitHit", "stopLossHit", "win", "lossLabel", "winRate", "profitFactor",
    "drawdown", "Sharpe", "Calmar", "expectedReturn", "economicOutcome", "tradeOutcome",
    "realizedPnL", "unrealizedPnL"
  ],
  "upstreamFeedback": {
    "allowed": false,
