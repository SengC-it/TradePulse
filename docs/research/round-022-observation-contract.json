{
  "schemaVersion": "m3-r22-observation-design-001",
  "roundId": "baseline-002-research-round-022",
  "phase": "OBSERVATION_DESIGN_ONLY",
  "acceptedSource": {
    "repository": "SengC-it/TradePulse",
    "baseBranch": "research/round-015-beta-alpha-decomposition",
    "sha": "60b003a80e231ace69e4fc4d4217a7d22724ce1b"
  },
  "purpose": "Prospective, non-economic observation of advisory completeness, stability, understandability, and human reviewability.",
  "boundary": {
    "humanDecisionRequired": true,
    "automaticTrading": false,
    "terminalReadOnlyEvidence": true,
    "signalGenerationFeedback": false,
    "economicQuestion": false
  },
  "prospectiveWindow": {
    "t0": null,
    "t0Configured": false,
    "windowStart": "T0 inclusive",
    "windowEnd": "T0 + 30 calendar days exclusive",
    "durationCalendarDays": 30,
    "historicalBackfillAllowed": false,
    "retrospectiveSamplingAllowed": false,
    "resultBasedExtensionAllowed": false,
    "earlyStoppingAllowed": false,
    "insufficientDataOutcome": "OBSERVATION_INSUFFICIENT_DATA"
  },
  "cohorts": {
    "ADVISORY": {
      "unit": "one unique directional advisory identity",
      "directions": ["LONG", "SHORT"],
      "noSignal": "excluded from alert denominators"
    },
    "NOTIFICATION": {
      "unit": "one actual notification observation",
      "dispositions": ["DELIVERED", "IGNORED", "SUPPRESSED", "DUPLICATE_SKIPPED"],
      "duplicateEvidence": "retained; never removed by deduplication"
    },
    "HUMAN_REVIEW": {
      "unit": "one valid human review observation",
      "labels": ["reviewComplete", "informationSufficient", "unnecessaryAlert"]
    }
  },
  "denominatorContract": {
    "advisory": "unique valid ADVISORY records with LONG or SHORT direction",
    "notification": "every valid NOTIFICATION record, including duplicate notifications",
    "humanReview": "every valid HUMAN_REVIEW record with a human-supplied review label",
    "noSignal": "NO_SIGNAL is pipeline metadata only and is excluded from every alert denominator",
    "missing": "NOT_EVALUABLE records are excluded and never imputed as zero"
  },
  "directionContract": {
    "allowed": ["LONG", "SHORT", "NO_SIGNAL"],
    "reporting": ["LONG", "SHORT", "POOLED"],
    "noSignalInterpretation": "pipeline count only; not success or failure"
  },
  "pitAndProvenanceContract": {
    "rule": "Every required snapshotTime must be <= signalTime and <= advisoryCreationTime.",
    "sourceIdentityRequired": true,
    "sourceHashRequired": true,
    "immutableSnapshotRequired": true,
    "missingProvenanceOutcome": "NOT_EVALUABLE",
    "futureMetadataRecalculationAllowed": false,
    "futureMetadataOverwriteAllowed": false
  },
  "humanReviewContract": {
    "requiredFields": [
      "reviewStartedAt",
      "reviewSubmittedAt",
      "reviewComplete",
      "informationSufficient",
      "unnecessaryAlert"
    ],
    "decisionLatencyProxyMs": "reviewSubmittedAt - reviewStartedAt",
    "submittedAtMustBeGreaterThanOrEqualToStartedAt": true,
    "economicOrExecutionLatency": false,
    "unnecessaryAlertSource": "human label only",
    "outcomeLeakageAllowed": false
  },
  "dataProvenance": [
    {
      "field": "identityKey",
      "sourceModuleOrPersistence": "src/lib/signal-advisory/identity.ts; public.tp_signal_advisories.signal_id",
      "captureTime": "signal creation / advisory persistence",
      "mutability": "IMMUTABLE",
      "required": true,
      "status": "AVAILABLE_SOURCE"
    },
    {
      "field": "signalTime",
      "sourceModuleOrPersistence": "src/lib/signal-advisory/scan.ts; public.tp_signal_advisories.signal_time",
      "captureTime": "advisory persistence",
      "mutability": "IMMUTABLE",
      "required": true,
      "status": "AVAILABLE_SOURCE"
    },
    {
      "field": "direction",
